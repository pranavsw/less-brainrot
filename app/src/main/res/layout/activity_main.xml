<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textAppearance="?attr/textAppearanceHeadlineSmall" />
        <TextView android:id="@+id/serviceStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp" />
        <Button android:id="@+id/accessibilityButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_open_accessibility" />
        <TextView android:id="@+id/overlayStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" />
        <Button android:id="@+id/overlayButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_grant_overlay" />
        <TextView android:id="@+id/batteryStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" />
        <Button android:id="@+id/batteryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_request_battery_exemption" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/instagramEnabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="@string/settings_track_instagram" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/youtubeEnabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_track_youtube" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/overlayEnabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_floating_counter" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/diagnosticEnabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_developer_diagnostics" />
        <TextView android:id="@+id/classification" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp" />
        <TextView android:id="@+id/totals" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" />
        <Button android:id="@+id/resetButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_reset_counters" />
        <Button android:id="@+id/diagnosticButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_export_diagnostics" />
    </LinearLayout>
</ScrollView>
